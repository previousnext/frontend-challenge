<div class="mx-accordions">
  {% if toggleAll %}
  <mx-accordion-group>
    {% endif %}
    {% if title is not empty or toggleAll %}
      <div class="mx-accordion__title">
        {{ title }}
        {% if toggleAll %}
          <div class="mx-accordions__toggle-all">
            <button data-toggle-all aria-expanded="false" class="mx-button mx-button--light mx-button--small" type="button"><span class="mx-accordions__expand-label">Expand all</span><span class="mx-accordions__collapse-label">Collapse all</span></button>
          </div>
        {% endif %}
      </div>
    {% endif %}
    {{ items }}
    {% if toggleAll %}
  </mx-accordion-group>
  {% endif %}
</div>
