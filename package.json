{
  "name": "pnx-fe-challenge",
  "version": "0.0.1",
  "description": "PNX Frontend Technical Challenge",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "storybook dev -p 6006",
    "build": "storybook build -o dist/storybook",
    "test": "vitest --project=storybook --run",
    "lint": "pnpm lint-format && pnpm lint-css && pnpm lint-ts && pnpm lint-js",
    "format": "oxfmt && pnpm fix-css && pnpm fix-js",
    "lint-format": "oxfmt --check",
    "lint-css": "stylelint \"./**/*.css\"",
    "lint-js": "oxlint src",
    "lint-ts": "tsc",
    "fix-css": "pnpm lint-css --fix",
    "fix-js": "pnpm lint-js --fix"
  },
  "dependencies": {
    "@pnx-mixtape/ids-shape": "^0.0.27"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@csstools/stylelint-formatter-github": "^3.0.0",
    "@storybook/addon-a11y": "^10.6.9",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/addon-links": "^10.6.9",
    "@storybook/addon-vitest": "^10.6.9",
    "@storybook/html-vite": "^10.6.9",
    "@types/node": "^26.6.10",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.2",
    "@vitest/coverage-v8": "^5.1.2",
    "axe-playwright": "^2.2.2",
    "concurrently": "^10.0.7",
    "cz-conventional-changelog": "^3.3.0",
    "drupal-attribute": "^1.2.1",
    "drupal-twig-extensions": "1.0.0-beta.5",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "postcss-custom-media": "^12.0.4",
    "postcss-design-tokens": "^1.3.0",
    "postcss-inline-svg": "^6.0.0",
    "postcss-mixins": "^12.1.2",
    "postcss-prepend-layer": "^1.0.2",
    "postcss-preset-env": "^11.6.3",
    "postcss-pxtorem": "^6.1.0",
    "storybook": "^10.6.9",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "stylelint-use-logical-spec": "^6.0.1",
    "twig": "^3.0.0",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "vite-plugin-twig-drupal": "^1.6.2",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">= 24.0"
  },
  "packageManager": "pnpm@12.23.0"
}
